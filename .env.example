# Copy to .env and fill in. Never commit .env.

# --- LLM provider (pick one to start) ---
OPENAI_API_KEY=
# or, for local/hosted OSS models:
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small

# --- Vector DB (Qdrant) ---
QDRANT_URL=http://localhost:6333

# --- Graph DB (Neo4j) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# --- Postgres (async SQLAlchemy — note the +asyncpg driver) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic
# Episodic memory backend: sqlite (default) or postgres
MEMORY_BACKEND=sqlite

# --- Fine-tuned model serving (optional) ---
# Serve a locally merged LoRA model on /chat; falls back to the API if missing.
USE_FINETUNED=false
FINETUNED_MODEL_DIR=artifacts/lora-adapter-merged

# --- Observability (optional) ---
# Set both keys to export per-run traces to Langfuse (cloud or self-hosted).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
# 32+ char secret in production
JWT_SECRET=
