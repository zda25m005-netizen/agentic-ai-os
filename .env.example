# Copy to .env and fill in. Never commit .env.

# --- LLM provider (pick one to start) ---
OPENAI_API_KEY=
# or, for local/hosted OSS models:
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small

# --- Vector DB (Qdrant) ---
QDRANT_URL=http://localhost:6333

# --- Graph DB (Neo4j) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# --- Postgres (async SQLAlchemy — note the +asyncpg driver) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
# 32+ char secret in production
JWT_SECRET=
