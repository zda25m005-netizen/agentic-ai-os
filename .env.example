# Copy to .env and fill in. Never commit .env.

# --- LLM provider (pick one to start) ---
OPENAI_API_KEY=
# or, for local/hosted OSS models:
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small

# --- Vector DB (Qdrant) ---
QDRANT_URL=http://localhost:6333

# --- Postgres ---
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/agentic

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
