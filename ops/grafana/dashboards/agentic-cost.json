{
  "uid": "agentic-cost",
  "title": "Agentic AI OS — LLM Cost & Tokens",
  "tags": ["agentic"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Estimated LLM cost (USD, cumulative)",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 6 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "agentic_llm_cost_usd_total",
          "legendFormat": "cost"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total tokens (prompt + completion)",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(agentic_llm_tokens_total)",
          "legendFormat": "tokens"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Token rate (tokens/s) by type",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(agentic_llm_tokens_total[5m])) by (type)",
          "legendFormat": "{{type}}"
        }
      ]
    }
  ]
}
