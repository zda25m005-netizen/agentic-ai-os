{
  "uid": "agentic-agents",
  "title": "Agentic AI OS — Agent Nodes & Tools",
  "tags": ["agentic"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Agent node executions/s by node",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(agentic_agent_node_runs_total[5m])) by (node)",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Tool calls (last 1h) by tool",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(agentic_tool_calls_total[1h])) by (tool)",
          "legendFormat": "{{tool}}",
          "instant": true
        }
      ]
    }
  ]
}
